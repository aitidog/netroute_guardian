# Copy to deploy/.env.prod (chmod 600) before starting docker-compose.prod.yml
# NEVER commit deploy/.env.prod to Git!

DOMAIN=netroute.xiangyucloud.com

# Strong random PostgreSQL credentials (generate via: openssl rand -hex 24)
POSTGRES_USER=route_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=route_table_mgm

# Caddy HTTP Basic Auth credentials protecting Web UI, API, and Mailpit
# Generate BASIC_AUTH_HASH via:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
# Note: escape any '$' signs as '$$' if placing directly in Compose env, or pass via --env-file
BASIC_AUTH_USER=reviewer
BASIC_AUTH_HASH=CHANGE_ME_BCRYPT_HASH

# Tuned for 2 GB RAM AWS Lightsail (use 4 on 4+ GB instances)
PIPELINE_MAX_WORKERS=2
